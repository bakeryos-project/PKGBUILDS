# Maintainer: smtdfc <me.smtdfc@gmail.com>

pkgname=bakeryos-connect
pkgver=0.1.0
pkgrel=1
pkgdesc="Connect app for BakeryOS"
arch=('any')
url=""
license=('GPL-3.0-or-later')
depends=(
  'python'
  'python-gobject'
  'gtk4'
  'libadwaita'
)
makedepends=(
  'meson'
  'ninja'
  'blueprint-compiler'
  'gettext'
  'desktop-file-utils'
  'appstream'
)
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/bakeryos-project/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)

build() {
    cd "$srcdir/${pkgname}-${pkgver}"

    arch-meson . build
    meson compile -C build
}

package() {
    cd "$srcdir/${pkgname}-${pkgver}"
    meson install -C build --no-rebuild --destdir "$pkgdir"
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
