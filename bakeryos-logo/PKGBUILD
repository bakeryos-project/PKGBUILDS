# Maintainer: smtdfc <me.smdtfc@gmail.com>

pkgname=bakeryos-logo
pkgver=1.2.0
pkgrel=1
pkgdesc="Logo of BakeryOS"
arch=('any')
url="https://github.com/bakeryos-project/bakeryos-logo"
license=("GPL-3.0-or-later")
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/bakeryos-project/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)

options=(!debug !strip)
provides=('bakeryos-logo')
conflicts=('bakeryos-logo')
install=bakeryos-logo.install

package() {
    cd "$srcdir/${pkgname}-${pkgver}"
    install -d "${pkgdir}/usr/share"
    install -d "${pkgdir}/usr/share/bakeryos/logo"
    install -d "${pkgdir}/usr/share/pixmaps"
    for img in "src/bakeryos/logo/"*; do
        if [ -f "$img" ]; then
        install -Dm644 "$img" "${pkgdir}/usr/share/bakeryos/logo/$(basename "$img")"
        fi
    done
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
sha256sums=('ea47bf11eb5854d97fba4d97759b45e509398a59432e71e9dfb118beb5e48dd0')
