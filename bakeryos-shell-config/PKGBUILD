# Maintainer: smtdfc <me.smtdfc@gmail.com>

pkgname=bakeryos-shell-config
pkgver=1.3.0
pkgrel=1
pkgdesc="Default shell environment for BakeryOS"
arch=('any')
url="https://github.com/bakeryos-project/bakeryos-shell-config"
license=('GPL-3.0-or-later')
depends=('zsh' 'bakeryos-oh-my-zsh' 'bakeryos-fastfetch' 'zsh-autosuggestions' 'zsh-syntax-highlighting')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/bakeryos-project/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)

sha256sums=('7ead2a95d7c1811f43146754bbc5994546836db7eb5902ea26276c2ee18fd8f6')
options=(!debug !strip)

package() {
    cd "$srcdir/${pkgname}-${pkgver}"

    install -d "$pkgdir/etc/skel"
    install -d "$pkgdir/etc/skel/.config"
    cp -a skel/. "$pkgdir/etc/skel/"

    rm -f "$pkgdir/etc/skel/.bashrc"

    local dir
    for dir in Desktop Documents Downloads Music Pictures Public Templates Videos; do
        install -d -m 0755 "$pkgdir/etc/skel/${dir}"
    done

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
