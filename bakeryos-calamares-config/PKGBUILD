# Maintainer: smtdfc <me.smtdfc@gmail.com>

pkgname=bakeryos-calamares-config
pkgver=1.2.0
pkgrel=1
pkgdesc="Calamares config for BakeryOS"
url="https://github.com/bakeryos-project/bakeryos-calamares-config"
arch=('any')
license=("GPL-3.0-or-later")
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/bakeryos-project/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)
options=(!debug !strip)

package() {
    cd "$srcdir/${pkgname}-${pkgver}"
    install -d "${pkgdir}/etc"
    cp -r etc/* "${pkgdir}/etc/"

    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
sha256sums=('b41ef35e7a3ff8fce58b7671f6b0d315f89030b820c515e7861468a843faa0ad')
