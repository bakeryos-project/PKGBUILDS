# Maintainer: smtdfc <me.smtdfc@gmail.com>

pkgname=bakeryos-fonts-setup
pkgver=1.2.0
pkgrel=1
pkgdesc="A font setup script for BakeryOS"
arch=('any')
url="https://github.com/bakeryos-project/bakeryos-fonts-setup"
license=('GPL-3.0-or-later')
backup=('etc/fonts/local.conf')
depends=(
  'fontconfig'
  'freetype2'
  'ttf-dejavu'
  'ttf-liberation'
  'noto-fonts'
  'noto-fonts-emoji'
  'noto-fonts-cjk'
  'adobe-source-han-sans-otc-fonts'
  'adobe-source-han-serif-otc-fonts'
  'ttf-roboto'
  'ttf-roboto-mono'
  'ttf-ubuntu-font-family'
  'ttf-fira-code'
  'ttf-fira-sans'
  'ttf-fira-mono'
)
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/bakeryos-project/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)
options=(!debug !strip)

package() {
  cd "$srcdir/${pkgname}-${pkgver}"
  install -Dm644 "fonts/local.conf" "${pkgdir}/etc/fonts/local.conf"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

sha256sums=('9629239e5d61486dd8c0383aca49279822877ea29333b2bf90d86bc72d4e518b')
