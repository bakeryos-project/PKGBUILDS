# Maintainer: smtdfc <me.smdtfc@gmail.com>

pkgname=bakeryos-libalpm-hooks
pkgver=1.2.1
pkgrel=1
pkgdesc="Custom libalpm hooks for BakeryOS"
url="https://github.com/bakeryos-project/bakeryos-libalpm-hooks"
arch=('any')
options=(!debug !strip)
license=("GPL-3.0-or-later")
depends=('pacman' 'libnotify')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/bakeryos-project/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz"
)


package() {
    cd "$srcdir/${pkgname}-${pkgver}"

    install -Dm755 "src/bakeryos-reboot-notify.sh"  "$pkgdir/usr/bin/bakeryos-reboot-notify"
    install -Dm755 "src/bakeryos-os-release-setup"  "$pkgdir/usr/bin/bakeryos-os-release-setup"
    install -Dm755 "src/bakeryos-lsb-release-setup"  "$pkgdir/usr/bin/bakeryos-lsb-release-setup"


    install -Dm644 "src/bakeryos-reboot-required.hook" "$pkgdir/usr/share/libalpm/hooks/bakeryos-reboot-required.hook"
    install -Dm644 "src/bakeryos-lsb-release.hook" "$pkgdir/usr/share/libalpm/hooks/bakeryos-lsb-release.hook"
    install -Dm644 "src/bakeryos-os-release.hook" "$pkgdir/usr/share/libalpm/hooks/bakeryos-os-release.hook"

    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
sha256sums=('8e1e430de24cc76bfdf43047ab222c85de3d00f1a32bedb881ce531390fad8d9')
