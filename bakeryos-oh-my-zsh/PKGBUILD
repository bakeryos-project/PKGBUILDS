# Maintainer: smtdfc <me.smtdfc@gmail.com>

pkgname=bakeryos-oh-my-zsh
pkgver=1.0.0
pkgrel=1
pkgdesc="Oh My Zsh framework, installed system-wide for BakeryOS"
arch=('any')

license=('MIT')
depends=('zsh')
optdepends=(
    'zsh-autosuggestions: fish-like autosuggestions'
    'zsh-syntax-highlighting: syntax highlighting while typing'
)
provides=('oh-my-zsh')
conflicts=('oh-my-zsh-git')

_upstream_commit=c0140703a53eb0d22be44f7bac318d0baacc927c

source=("oh-my-zsh-${pkgver}.tar.gz::https://github.com/ohmyzsh/ohmyzsh/archive/${_upstream_commit}.tar.gz")
sha256sums=('9b0661db3e7466dd396de2a1591ff9b5981572417649254c9d656ac086b09251')

options=(!debug !strip)

package() {
    cd "$srcdir/ohmyzsh-${_upstream_commit}"

    install -d "$pkgdir/usr/share/oh-my-zsh"
    cp -a . "$pkgdir/usr/share/oh-my-zsh/"

    rm -rf "$pkgdir/usr/share/oh-my-zsh/.github" \
           "$pkgdir/usr/share/oh-my-zsh/.devcontainer"
    rm -f  "$pkgdir/usr/share/oh-my-zsh/.editorconfig" \
           "$pkgdir/usr/share/oh-my-zsh/.gitignore" \
           "$pkgdir/usr/share/oh-my-zsh/.prettierrc"

    rm -rf "$pkgdir/usr/share/oh-my-zsh/cache" \
           "$pkgdir/usr/share/oh-my-zsh/log"

    install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/${pkgname}/LICENSE.txt"
}
